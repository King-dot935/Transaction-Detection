{"id": "R03", "type": "诱导线下交易", "severity": "high", "priority": 1, "patterns": ["加微信", "加我微信", "加我好友", "加v", "私聊", "微信转账", "转账给我", "私下转", "私下给", "发红包", "支付宝转"], "clause": "TRANS_2.1", "hint": "引导脱离平台交易，出了纠纷平台无法保障你的资金和售后。", "action": "立即介入"}
{"id": "R04", "type": "以利益换好评", "severity": "high", "priority": 1, "patterns": ["删差评", "差评删", "改好评", "好评返现", "删了评价", "五星好评", "评价改", "评价撤", "改了马上退", "撤了马上退", "改个评价", "撤个评价"], "clause": "EVAL_4.2", "hint": "以退款为条件要求删差评或改好评，属于干预评价，平台规则禁止。", "action": "立即介入"}
{"id": "R05", "type": "威胁或辱骂", "severity": "high", "priority": 1, "patterns": ["你等着", "投诉也没用", "爱要不要", "滚", "废物", "傻"], "clause": "COMMUNITY_3.4", "hint": "对方出现威胁或辱骂，已超出正常售后沟通范围。", "action": "立即介入"}
{"id": "R08", "type": "索要不必要的身份信息", "severity": "high", "priority": 1, "patterns": ["身份证照片", "手持身份证", "银行卡号", "验证码", "密码", "身份证拍", "拍身份证", "身份证正反面", "手持"], "clause": "PRIVACY_8.1", "hint": "售后不需要验证码、密码或手持身份证，索要这些信息有盗号风险。", "action": "立即介入"}
{"id": "R02", "type": "扩大退货例外", "severity": "mid", "priority": 5, "patterns": ["拆封不退", "拆开不退", "拆封了就不能退", "拆开就不退", "拆封的不能退", "拆了就不能退", "拆了就是拆了", "拆了就不给退", "公司规定拆"], "clause": "RETURN_7.3", "hint": "拆封本身不当然排除无理由退货，只有影响二次销售才受限，需要商家举证。", "action": "提示权利"}
{"id": "R09", "type": "诱导放弃权利", "severity": "mid", "priority": 5, "patterns": ["签收即认可", "签收就代表认可", "详情页写了", "最终解释权", "概不退换"], "clause": "RETURN_7.1", "hint": "以「详情页写了」「最终解释权」排除法定权利，这类条款不生效。", "action": "提示权利"}
{"id": "R01", "type": "拒绝法定权利", "severity": "mid", "priority": 10, "rights": ["退", "换", "售后", "发票", "开票"], "denials": ["不退", "不能退", "不支持", "不给退", "退不了", "走不了", "处理不了", "不换", "概不", "不开票", "开不了", "没发票", "不行"], "clause": "RETURN_7.1", "hint": "除定制、鲜活等法定例外，7 天内可无理由退货；「特价不退」不是合法理由。", "action": "提示权利"}
{"id": "R10", "type": "拒绝开票", "severity": "mid", "priority": 5, "patterns": ["不开发票", "开不了发票", "没有发票", "不开票"], "clause": "INVOICE_10.1", "hint": "订单完成后可申请电子发票，「开不了」不是合法理由。", "action": "提示权利"}
{"id": "R06", "type": "责任推诿", "severity": "mid", "priority": 30, "patterns": ["物流的问题", "找快递去", "你签收就代表", "我们没责任", "你自己弄坏", "是快递弄的"], "clause": "QUALITY_9.1", "hint": "质量问题需要商家举证或检测，不能仅凭「签收即认可」推给物流或消费者。", "action": "提示权利"}
{"id": "R07", "type": "反复拖延", "severity": "low", "priority": 40, "patterns": ["明天回复", "稍等", "在处理了", "等通知", "再等等", "过几天", "下周再说"], "repeat_threshold": 3, "clause": "SERVICE_16.1", "hint": "对方在反复拖延，建议给出明确时限并保留记录。", "action": "提示"}
{"id": "R11", "type": "虚假承诺", "severity": "low", "priority": 50, "patterns": ["假一赔十", "保证正品", "绝对没问题", "百分百"], "clause": "QUALITY_9.1", "hint": "口头承诺需要落到平台规则，主张权利时以订单与规则为准。", "action": "提示"}
{"id": "R12", "type": "正常沟通", "severity": "none", "priority": 0, "negative": true, "patterns": ["已经安排", "今天发出", "帮您登记", "可以退", "给您处理", "随时找我", "马上给您换"]}
